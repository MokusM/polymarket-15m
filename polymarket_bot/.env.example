# ══════════════════════════════════════════════
#  TELEGRAM
# ══════════════════════════════════════════════
TELEGRAM_TOKEN=your_telegram_bot_token_here   # з @BotFather
CHAT_ID=your_chat_id_here                     # ваш Chat ID

# ══════════════════════════════════════════════
#  TRADING MODE
# ══════════════════════════════════════════════
LIVE_TRADING=false          # true = реальні ордери на Polymarket
AUTO_APPROVE_LIVE=false     # true = автоматично виконувати ордер без підтвердження
AUTO_APPROVE_PAPER=true     # автоматичний approve у paper-режимі
STAKE_USD=10                # ставка для paper / test режиму ($)

# ══════════════════════════════════════════════
#  POLYMARKET LIVE (CLOB)
# ══════════════════════════════════════════════
POLYMARKET_PRIVATE_KEY=0x...your_private_key_here
POLYMARKET_CHAIN_ID=137
# signature_type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
# Акаунти polymarket.com через браузер = 2 (Gnosis Safe)
POLYMARKET_SIGNATURE_TYPE=2
# Proxy/Safe адреса з профілю Polymarket (Settings → Wallet address)
POLYMARKET_FUNDER_ADDRESS=0x...your_proxy_address_here
# Підняти ліміт BUY до best ask (менше «висить» у стакані, швидше fill)
CLOB_CROSS_SPREAD_BUY=true
# Попередження якщо ask відхилився від ціни сигналу більше ніж на N¢ (0 = без обмеження)
CLOB_MAX_BUY_SLIPPAGE_ABS=0.05

# ══════════════════════════════════════════════
#  BANKROLL & KELLY SIZING
# ══════════════════════════════════════════════
BANKROLL_USD=20             # загальний банкрол для Kelly ($)
KELLY_FRACTION=0.25         # частка Kelly (0.25 = quarter-Kelly, консервативно)
MIN_STAKE_USD=1             # мінімальна ставка ($)
MAX_STAKE_USD=5             # максимальна ставка ($)
MAX_OPEN_POSITIONS=1        # макс. одночасних позицій

# ══════════════════════════════════════════════
#  STOP-LOSS / TAKE-PROFIT LADDER
# ══════════════════════════════════════════════
# Ladder (PolySigma): 90¢→25%, 93¢→25%, 95¢→25%, 97¢→100%
SL_PERCENT=40               # SL = entry * (1 - SL_PERCENT/100)
TP_PARTIAL_PRICE=0.90       # L1: перший частковий вихід
TP_PARTIAL_SELL_PCT=25      # % залишку для продажу на L1
TP_MID_PRICE=0.93           # L2: другий частковий вихід (33% залишку)
TP_FULL_PRICE=0.95          # L3: третій частковий вихід (50% залишку)
TP_FINAL_PRICE=0.97         # L4: повний вихід (все що залишилось)
POSITION_MONITOR_INTERVAL=10    # інтервал перевірки позицій (сек, коли немає відкритих)
# SL → беззбиток після N% нереалізованого прибутку від ставки на залишок (0 = вимкнути)
BREAKEVEN_AFTER_ROI_PCT=50

# ══════════════════════════════════════════════
#  SIGNAL FILTERS
# ══════════════════════════════════════════════
# GAP: мінімальна відстань BTC від страйку (PTB) у доларах
# <$50 = WR ~65%, $50+ = WR 82%+, $100+ = WR ~100% (PolySigma)
GAP_MIN_USD=50
# Strict GAP: якщо ціна > CONTRACT_PRICE_HIGH_MIN або час < TIME_STRICT_MAX_MIN
# то потрібен GAP >= GAP_STRICT_USD (100$)
GAP_STRICT_USD=100
CONTRACT_PRICE_HIGH_MIN=0.75  # ціна вище цього → потрібен строгий GAP
TIME_STRICT_MAX_MIN=5.0       # залишок часу менше цього (хв) → потрібен строгий GAP

# ATR: мінімальна волатильність BTC ($ за хвилину); менше = «мертвий» ринок
ATR_MIN_USD=30

# OBI: дисбаланс стакану Binance (bid_volume / ask_volume)
# 0 = вимкнути фільтр; 1.2 = потрібен 20% перевіс у потрібний бік
OBI_MIN_RATIO=0
OBI_LEVELS=5

# CLOB спред: пропустити сигнал якщо bid-ask > N¢ (неліквідний ринок)
CLOB_SPREAD_MAX=0.03

# ══════════════════════════════════════════════
#  CIRCUIT BREAKER
# ══════════════════════════════════════════════
# Після N збитків підряд — live trading автоматично вимикається (команда /reset)
CIRCUIT_BREAKER_LOSSES=3

# ══════════════════════════════════════════════
#  ІНШЕ
# ══════════════════════════════════════════════
CLOB_TRADE_HISTORY_LIMIT=10       # кількість угод у /history
CLOB_TRADE_HISTORY_MAX_PAGES=3    # сторінок CLOB для /history
