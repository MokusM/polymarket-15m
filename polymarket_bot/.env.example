# ══════════════════════════════════════════════
#  SECRETS
# ══════════════════════════════════════════════
TELEGRAM_TOKEN=your_telegram_bot_token
CHAT_ID=your_chat_id
POLYMARKET_PRIVATE_KEY=0x...your_private_key
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=2   # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
POLYMARKET_FUNDER_ADDRESS=0x...your_proxy_address

# ══════════════════════════════════════════════
#  INSTANCE SETTINGS
# ══════════════════════════════════════════════
DEFAULT_MODE=light             # light / medium / strict / test
TELEGRAM_ENABLED=true
LIVE_TRADING=false
AUTO_APPROVE_LIVE=false
AUTO_APPROVE_PAPER=true

# ══════════════════════════════════════════════
#  BANKROLL & KELLY
# ══════════════════════════════════════════════
BANKROLL_USD=30
KELLY_FRACTION=0.25
MIN_STAKE_USD=1
MAX_STAKE_USD=5
MAX_OPEN_POSITIONS=1

# ══════════════════════════════════════════════
#  CLOB EXECUTION
# ══════════════════════════════════════════════
CLOB_CROSS_SPREAD_BUY=true
CLOB_MAX_BUY_SLIPPAGE_ABS=0.05
CLOB_SPREAD_MAX=1

# ══════════════════════════════════════════════
#  STOP-LOSS / TAKE-PROFIT
# ══════════════════════════════════════════════
SL_PERCENT=25
TP_PARTIAL_PRICE=0.90
TP_PARTIAL_SELL_PCT=25
TP_MID_PRICE=0.93
TP_FULL_PRICE=0.95
TP_FINAL_PRICE=0.97
POSITION_MONITOR_INTERVAL=3
BREAKEVEN_AFTER_ROI_PCT=50
