# Токен бота, отриманий в @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Ваш Chat ID для отримання сигналів
CHAT_ID=your_chat_id_here

# Paper trading
STAKE_USD=10
AUTO_APPROVE_PAPER=true

# ── Live trading ──
LIVE_TRADING=false
AUTO_APPROVE_LIVE=false

# BUY-ордер: підняти ліміт до best ask (менше «висить» у стакані)
CLOB_CROSS_SPREAD_BUY=true
# Попередження в лог, якщо ask далі від ціни сигналу ніж N; відмова ордера — лише якщо ask > CONTRACT_PRICE_MAX (0.72)
CLOB_MAX_BUY_SLIPPAGE_ABS=0.05
POLYMARKET_PRIVATE_KEY=your_ethereum_private_key_here
POLYMARKET_CHAIN_ID=137
# signature_type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE (Polymarket.com accounts use 2)
POLYMARKET_SIGNATURE_TYPE=2
# funder: your proxy/safe wallet address (shown in Polymarket profile or trades API)
POLYMARKET_FUNDER_ADDRESS=your_proxy_wallet_address_here

# Bankroll & Kelly sizing
BANKROLL_USD=20
KELLY_FRACTION=0.25
MIN_STAKE_USD=1
MAX_STAKE_USD=5
MAX_OPEN_POSITIONS=3

# Stop-loss & take-profit (absolute contract price levels)
SL_PERCENT=40
TP_PARTIAL_PRICE=0.90
TP_PARTIAL_SELL_PCT=50
TP_FULL_PRICE=0.95
POSITION_MONITOR_INTERVAL=10
# Нереалізований PnL >= N% від ставки на залишок → SL на ціну входу (0 = вимкнути)
BREAKEVEN_AFTER_ROI_PCT=50

# /history у Telegram: останні угоди з CLOB
CLOB_TRADE_HISTORY_LIMIT=10
CLOB_TRADE_HISTORY_MAX_PAGES=3

# ── Signal filters ──
# Контрактна ціна: сигнал проходить якщо CLOB ask в цій зоні
CONTRACT_PRICE_MIN=0.50
CONTRACT_PRICE_MAX=0.85
# GAP: мінімальна різниця BTC vs страйк ($)
GAP_MIN_USD=30
# OBI: мінімальний дисбаланс стакану Binance (1.0 = нейтрально)
OBI_MIN_RATIO=1.05
OBI_LEVELS=5
# ATR: мінімальна волатильність ($)
ATR_MIN_USD=30
